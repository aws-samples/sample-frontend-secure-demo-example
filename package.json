    "@aws-amplify/ui-react": "^6.5.5",
    "aws-amplify": "^6.18.0",
    "dompurify": "^3.4.11",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/dompurify": "^3.0.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^5.0.4",
    "typescript": "^5.6.3",
    "vite": "^8.0.16"
  }
}
